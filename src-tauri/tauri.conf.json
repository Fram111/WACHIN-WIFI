{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WACHIN-WIFI",
  "version": "0.1.0",
  "identifier": "com.wachinwifi.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "WACHIN-WIFI", "width": 1200, "height": 800, "minWidth": 800, "minHeight": 600 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost" } },
  "bundle": { "active": false }
}
